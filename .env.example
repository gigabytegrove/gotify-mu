# Monita build identity shown in the Web UI.
MONITA_VERSION=master-local
MONITA_COMMIT=local

# Copy this file to .env before starting Monita.
MONITA_PORT=8080

# Persistent host directory mounted at /app/data.
MONITA_DATA_DIR=./data

# Gotify-compatible authentication variables remain intentionally supported.
GOTIFY_DEFAULTUSER_NAME=admin
GOTIFY_DEFAULTUSER_PASS=CHANGE-THIS-PASSWORD

# Managed updates use the Docker socket mounted by docker-compose.yml.
# No separate updater service or updater token is required.

# Native receiver listeners are bound to loopback by default.
MONITA_RECEIVER_BIND=127.0.0.1
MONITA_SMTP_PORT=2525
MONITA_SYSLOG_PORT=5514

# Existing GOTIFY_MU_* values from older installations remain accepted by
# application code where compatibility matters. New deployments should use
# MONITA_* variables.

# Integration, connector, MFA, and other protected secrets are encrypted at rest.
# By default Monita stores its persistent secret key under /app/data.
# MONITA_SECRET_KEY=<64-hex-or-base64-encoded-32-byte-key>
# MONITA_SECRET_KEY_FILE=/run/secrets/monita_secret_key

# Optional plugin trust controls.
# MONITA_PLUGIN_ALLOW_UNSIGNED_INSTALLS=false
# MONITA_PLUGIN_TRUSTED_ED25519_KEYS=<comma-separated trusted Ed25519 public keys>
