# Optional build identity shown in the Gotify MU header.
GOTIFY_MU_VERSION=master-local
GOTIFY_MU_COMMIT=local

# Copy this file to .env before starting Gotify MU.
GOTIFY_MU_PORT=8080
GOTIFY_DEFAULTUSER_NAME=admin
GOTIFY_DEFAULTUSER_PASS=CHANGE-THIS-PASSWORD

# Required for the private server-to-updater control channel.
# Generate with: openssl rand -hex 32
GOTIFY_MU_UPDATER_TOKEN=CHANGE-THIS-TO-A-RANDOM-64-HEX-TOKEN
