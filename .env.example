# Optional build identity shown in the Gotify MU header.
GOTIFY_MU_VERSION=master-local
GOTIFY_MU_COMMIT=local

# Copy this file to .env before starting Gotify MU.
GOTIFY_MU_PORT=8080
GOTIFY_DEFAULTUSER_NAME=admin
GOTIFY_DEFAULTUSER_PASS=CHANGE-THIS-PASSWORD

# Required for the private server-to-updater control channel.
# Generate with: openssl rand -hex 32
GOTIFY_MU_UPDATER_TOKEN=CHANGE-THIS-TO-A-RANDOM-64-HEX-TOKEN

# Native receiver listeners are bound to loopback by default.
# Set this to a trusted LAN address (preferred) or 0.0.0.0 only when remote
# devices must reach the SMTP/Syslog receivers. Protect exposed listeners with
# host firewall rules and connector CIDR/authentication policies.
GOTIFY_MU_RECEIVER_BIND=127.0.0.1
GOTIFY_MU_SMTP_PORT=2525
GOTIFY_MU_SYSLOG_PORT=5514

# Integration, connector, MFA, and other protected secrets are encrypted at rest.
# By default Gotify MU creates data/.gotify-mu-secrets.key (0600) in persistent
# storage. For managed deployments you can supply a stable 32-byte key instead:
# GOTIFY_MU_SECRET_KEY=<64-hex-or-base64-encoded-32-byte-key>
# GOTIFY_MU_SECRET_KEY_FILE=/run/secrets/gotify_mu_secret_key

# Optional plugin trust controls. Unsigned plugin installation remains disabled
# unless explicitly enabled by the administrator.
# GOTIFY_MU_PLUGIN_ALLOW_UNSIGNED=false
# GOTIFY_MU_PLUGIN_TRUSTED_KEYS=<configured trusted Ed25519 public keys>
