# Container image used by Docker Compose.
MONITA_IMAGE=ghcr.io/gigabytegrove/monita:latest

# Copy this file to .env before starting Monita.
MONITA_PORT=8080

# Persistent host directory mounted at /app/data.
MONITA_DATA_DIR=./data

# Legacy GOTIFY_* variables remain accepted for backward compatibility.
MONITA_DEFAULTUSER_NAME=admin
MONITA_DEFAULTUSER_PASS=CHANGE-THIS-PASSWORD

# Native receiver listeners are bound to loopback by default.
MONITA_RECEIVER_BIND=127.0.0.1
MONITA_SMTP_PORT=2525
MONITA_SYSLOG_PORT=5514
