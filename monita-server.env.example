# Example environment variables for Monita.
# Legacy GOTIFY_* variables remain accepted as compatibility fallbacks.
# Save as `monita-server.env` (or export the variables) when edited.
#
# If $MONITA_CONFIG_FILE is set, that file is loaded exclusively and none of
# the files below are tried. Otherwise the first existing file from the search
# order is loaded. Absent or commented out settings fall back to the default
# (shown after the =). Variables already exported in the process environment
# always take precedence over the loaded file.
#
# Config file search order (used only when $MONITA_CONFIG_FILE is unset):
#   1. monita-server.env                       (in the working directory)
#   2. $XDG_CONFIG_HOME/monita/monita-server.env
#      ($XDG_CONFIG_HOME falls back to $HOME/.config when unset)
#   3. /etc/monita/server.env
#
# Value types used below:
#   text       a plain string value.
#   number     an integer value.
#   boolean    `true` or `false`.
#   text-list  comma-separated list of strings, parsed as a single CSV line.
#              A comma can be escaped by wrapping the value in quotes.
#              Example: a,b,c
#              Example: "a,b",c  -> entries: `a,b` and `c`
#   json-map   a JSON object mapping string keys to string values.
#              Example: {"X-Foo":"bar","X-Baz":"qux"}
#
# Every variable also supports a "_FILE" suffix that reads the value from a
# file at the given path (useful for Docker / Kubernetes secrets), e.g.:
#   MONITA_DEFAULTUSER_PASS_FILE=/run/secrets/admin_pass

# Minimum severity of log messages to emit.
# Values: trace, debug, info, warn, error, fatal, panic
# MONITA_LOGLEVEL=info

# Interval in seconds between TCP keepalive probes on accepted connections. !! Only change this if you know what you are doing.
#
# Example: 0 uses the Go default (15s)
# Example: -1 disables keepalives entirely.
# Type: number
# MONITA_SERVER_KEEPALIVEPERIODSECONDS=0

# The network address the HTTP server binds to. Leave empty to listen on all
# interfaces (both IPv4 and IPv6). Prefix with "unix:" to listen on a Unix
# domain socket instead of a TCP port.
#
# Type: text
# Example: 192.168.178.2
# Example: unix:/tmp/monita.sock
# MONITA_SERVER_LISTENADDR=

# Port the HTTP server listens on.
# Type: number
# MONITA_SERVER_PORT=80

# Enable the HTTPS listener. Requires either CERTFILE+CERTKEY or LETSENCRYPT_ENABLED=true.
# Type: boolean
# MONITA_SERVER_SSL_ENABLED=false

# Redirect plain HTTP requests to HTTPS. Only effective when SSL_ENABLED=true.
# Type: boolean
# MONITA_SERVER_SSL_REDIRECTTOHTTPS=true

# The network address the HTTPS server binds to. Leave empty to listen on all
# interfaces (both IPv4 and IPv6). Prefix with "unix:" to listen on a Unix
# domain socket instead of a TCP port.
#
# Type: text
# Example: 192.168.178.2
# Example: unix:/tmp/monita-ssl.sock
# MONITA_SERVER_SSL_LISTENADDR=

# Port the HTTPS server listens on.
# Type: number
# MONITA_SERVER_SSL_PORT=443

# Path to the TLS certificate.
# Type: text
# Example: /etc/ssl/certs/monita.crt
# MONITA_SERVER_SSL_CERTFILE=

# Path to the TLS private key.
# Type: text
# Example: /etc/ssl/private/monita.key
# MONITA_SERVER_SSL_CERTKEY=

# Obtain the TLS certificate automatically from Let's Encrypt.
# Requires SSL_ENABLED=true and LETSENCRYPT_ACCEPTTOS=true.
# Type: boolean
# MONITA_SERVER_SSL_LETSENCRYPT_ENABLED=false

# Accept the Let's Encrypt Terms of Service.
# Type: boolean
# MONITA_SERVER_SSL_LETSENCRYPT_ACCEPTTOS=false

# Directory where issued certificates and ACME account data are persisted. Must
# be writable by the server.
#
# Type: text
# Example: /var/lib/monita/certs
# MONITA_SERVER_SSL_LETSENCRYPT_CACHE=data/certs

# Override the ACME directory URL. Leave empty to use the Let's Encrypt
# production server. The staging server has higher rate limits useful for
# testing but issues certificates that are not publicly trusted.
#
# Type: text
# Example: https://acme-staging-v02.api.letsencrypt.org/directory
# MONITA_SERVER_SSL_LETSENCRYPT_DIRECTORYURL=

# Hosts Let's Encrypt should issue certificates for. Each host must resolve
# publicly to this server.
#
# Type: text-list
# Example: mydomain.tld,myotherdomain.tld
# MONITA_SERVER_SSL_LETSENCRYPT_HOSTS=

# Extra HTTP headers attached to every response.
# Type: json-map
# Example: {"X-Custom-Header":"custom value"}
# MONITA_SERVER_RESPONSEHEADERS=

# IPs or CIDR ranges of proxies whose X-Forwarded-For header is trusted to
# determine the real client IP. Include 127.0.0.1 when terminating TLS in a
# sidecar on the same host.
#
# Type: text-list
# Example: 127.0.0.1/32,::1
# MONITA_SERVER_TRUSTEDPROXIES=

# Set the Secure flag on session cookies, restricting them to HTTPS
# connections. Enable when the server is reachable over HTTPS.
#
# Type: boolean
# MONITA_SERVER_SECURECOOKIE=false

# Allowed origins (regex) for cross-origin requests. Setting any CORS_* value
# enables CORS handling.
#
# Type: text-list
# Example: .+\.example\.com,otherdomain\.com
# MONITA_SERVER_CORS_ALLOWORIGINS=

# HTTP methods permitted in cross-origin requests.
# Type: text-list
# Example: GET,POST
# MONITA_SERVER_CORS_ALLOWMETHODS=

# Request headers permitted in cross-origin requests.
# Type: text-list
# Example: Authorization,content-type
# MONITA_SERVER_CORS_ALLOWHEADERS=

# Interval in seconds between WebSocket ping frames sent to streaming clients.
# Only change this if you know what you are doing.
#
# Type: number
# MONITA_SERVER_STREAM_PINGPERIODSECONDS=45

# Allowed origins (regex) for WebSocket upgrade requests. Same-origin
# connections are always permitted regardless of this setting.
#
# Type: text-list
# Example: .+\.example\.com,otherdomain\.com
# MONITA_SERVER_STREAM_ALLOWEDORIGINS=

# Enable authentication via username and password.
# Type: boolean
# MONITA_LOCALAUTH_ENABLED=true

# Enable OpenID Connect Single Sign-On, allowing users to authenticate via an
# external identity provider (e.g. Authelia, Dex, Keycloak). The provider must
# support PKCE (https://oauth.net/2/pkce/); IdPs without PKCE support are
# currently unsupported.
#
# Type: boolean
# MONITA_OIDC_ENABLED=false

# Base URL of the identity provider. It will be used to discover OIDC endpoints
# via /.well-known/openid-configuration.
#
# Type: text
# Example: https://auth.example.com/realms/myrealm
# MONITA_OIDC_ISSUER=

# Client ID registered with the identity provider for this application.
# Type: text
# Example: monita
# MONITA_OIDC_CLIENTID=

# Client secret paired with the client ID.
# Type: text
# Example: super-secret
# MONITA_OIDC_CLIENTSECRET=

# Callback URL the identity provider redirects to after authentication. Must
# end with `/auth/oidc/callback` and match exactly what is registered at the
# provider. When Monita is served on a sub-path behind a reverse proxy, include
# it (e.g. https://example.org/monita/auth/oidc/callback). To support OIDC
# login in the Android app, also register `monita://oidc/callback` as an
# additional redirect URL at the provider.
#
# Type: text
# Example: https://monita.example.org/auth/oidc/callback
# MONITA_OIDC_REDIRECTURL=

# Automatically create a local user on first OIDC login. When disabled, only
# users that already exist in Monita can sign in via OIDC.
#
# Type: boolean
# MONITA_OIDC_AUTOREGISTER=true

# Bind an OIDC identity to a pre-existing local user with a matching username
# on first login. When disabled (default), existing local users are never
# claimed by an OIDC login and an identity whose username is already taken is
# rejected
#
# Type: boolean
# MONITA_OIDC_LINK_BY_USERNAME=false

# OIDC ID-token claim used as the local username. Common values are
# preferred_username or email.
#
# Type: text
# Example: email
# MONITA_OIDC_USERNAMECLAIM=preferred_username

# OIDC ID-token claim containing the group memberships as a list of strings.
# The claim must be part of the requested scopes (MONITA_OIDC_SCOPES). When
# set, admin permissions are managed by the identity provider on every login,
# overwriting manual changes.
#
# Type: text
# Example: groups
# MONITA_OIDC_GROUPS_CLAIM=

# Groups allowed to log in via OIDC and whose members are assigned user
# permissions. When empty, every user authenticated by the identity provider
# may log in.
#
# Type: text-list
# Example: messenger,monita
# MONITA_OIDC_GROUPS_USER=

# Groups allowed to log in via OIDC and whose members are assigned admin
# permissions.
#
# Type: text-list
# Example: admins,monita-admins
# MONITA_OIDC_GROUPS_ADMIN=

# OIDC scopes to request from the identity provider.
# Type: text-list
# MONITA_OIDC_SCOPES=openid,profile,email

# Automatically redirect to the OIDC identity provider instead of showing the
# login page. Users can still reach the login form by visiting the WebUI login
# route with ?redirect=false, e.g. https://push.example.com/#/login?redirect=false
#
# Type: boolean
# MONITA_OIDC_AUTO_REDIRECT=false

# Value of the `prompt` parameter sent to the OIDC provider for authentication.
# The value is passed to the IdP (commas are replaced with space).
# Set to empty to disable sending the parameter.
#
# See: https://openid.net/specs/openid-connect-core-1_0.html#AuthRequest
# See: https://openid.net/specs/openid-connect-prompt-create-1_0.html#OpenID.Core
# Type: text-list
# Example: consent,login
# MONITA_OIDC_PROMPT=login

# Name of the OIDC identity provider displayed in UI.
# Type: text
# Example: Authelia
# MONITA_OIDC_IDP_NAME=OIDC

# Database driver to use. For mysql and postgres the target database must
# already exist and the configured user must have sufficient permissions.
#
# Type: one of sqlite3, mysql, postgres
# MONITA_DATABASE_DIALECT=sqlite3

# Database connection string. Format depends on the dialect.
# Type: text
# Example:
#   sqlite3: path/to/database.db
#   mysql: monita:secret@tcp(localhost:3306)/monitadb?charset=utf8&parseTime=True&loc=Local
#   postgres: host=localhost port=5432 user=monita dbname=monitadb password=secret
# When using postgres without SSL, append `sslmode=disable` (see https://github.com/monita/server/issues/90).
# MONITA_DATABASE_CONNECTION=data/monita.db

# Username for the initial admin account. Only applied when the database is
# first created; later changes must be made through the WebUI.
#
# Type: text
# Example: myadmin
# MONITA_DEFAULTUSER_NAME=admin

# Password for the initial admin account. Only applied when the database is
# first created.
#
# Type: text
# Example: super-secret-password
# MONITA_DEFAULTUSER_PASS=admin

# Bcrypt cost factor for password hashes. Higher values are more secure but slower.
# Type: number
# MONITA_PASSSTRENGTH=10

# Directory where application icons and other uploaded images are stored. Must
# be writable by the server.
#
# Type: text
# Example: /var/lib/monita/images
# MONITA_UPLOADEDIMAGESDIR=data/images

# Directory scanned for plugin shared libraries on startup. Leave empty to
# disable plugin loading.
#
# Type: text
# Example: /var/lib/monita/plugins
# MONITA_PLUGINSDIR=data/plugins

# Allow unauthenticated users to register new user accounts via the public
# registration endpoint.
#
# Type: boolean
# MONITA_REGISTRATION=false

# Disable colored log output. Set to "1" to force-disable colors regardless of
# whether stdout is a terminal. When unset, colors are emitted only if stdout
# is a TTY. See https://no-color.org/.
#
# Type: text
# NOCOLOR=


# --- Monita authentication and security extensions ---

# Enable LDAP / Active Directory authentication.
# Type: boolean
# MONITA_LDAP_ENABLED=false
#
# Directory URL. Supported schemes include ldap:// and ldaps://.
# MONITA_LDAP_URL=ldaps://directory.example.com:636
#
# Optional service-account bind credentials.
# MONITA_LDAP_BIND_DN=CN=monita,OU=Service Accounts,DC=example,DC=com
# MONITA_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
#
# Search base and filter. {username} is substituted safely by the server.
# MONITA_LDAP_BASE_DN=DC=example,DC=com
# MONITA_LDAP_USER_FILTER=(sAMAccountName={username})
# MONITA_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# MONITA_LDAP_GROUP_ATTRIBUTE=memberOf
# MONITA_LDAP_ADMIN_GROUP_DN=CN=Monita Admins,OU=Groups,DC=example,DC=com
# MONITA_LDAP_USER_GROUP_DN=CN=Monita Users,OU=Groups,DC=example,DC=com
# MONITA_LDAP_AUTOREGISTER=true
# MONITA_LDAP_LINK_BY_USERNAME=false
# MONITA_LDAP_IDP_NAME=Directory
# MONITA_LDAP_CA_FILE=/etc/ssl/certs/internal-ca.pem
#
# Certificate verification should remain enabled. This escape hatch is intended
# only for temporary diagnostics and should not be used for normal deployments.
# MONITA_LDAP_INSECURE_SKIP_VERIFY=false

# Monita encrypts protected stored secrets with a 32-byte server key.
# If neither variable is set, a 0600 key file is created in persistent data.
# MONITA_SECRET_KEY=<64-hex-or-base64-encoded-32-byte-key>
# MONITA_SECRET_KEY_FILE=/run/secrets/monita_secret_key

# Native receiver listener addresses inside the server/container.
# Docker Compose publishes these through MONITA_RECEIVER_BIND and the host
# port variables shown in .env.example.
# MONITA_SMTP_LISTEN=:2525
# MONITA_SYSLOG_LISTEN=:5514

# Plugin trust and catalog controls.
# Unsigned native Go plugin installation is disabled by default.
# MONITA_PLUGIN_ALLOW_UNSIGNED_INSTALLS=false
# MONITA_PLUGIN_TRUSTED_ED25519_KEYS=<comma-separated trusted public keys>
# MONITA_PLUGIN_CATALOG_URL=https://plugins.example.com/monita/catalog.json
